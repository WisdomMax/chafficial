      <section id="tab-marketing" class="tab-content hidden space-y-6">
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-2xl font-bold tracking-tight text-white">마케팅 성과 파이프라인 분석</h1>
            <span class="text-xs bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2 py-0.5 rounded-full font-semibold">퍼널 데이터 모델</span>
          </div>
          <p class="text-sm text-slate-400 mt-1">영상 콘텐츠 노출부터 고객 유입, 상담, 최종 계약에 이르는 전 과정 퍼널 추적</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-3" id="marketingFunnelContainer">
          <!-- JS 렌더링 -->
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 space-y-3">
          <h3 class="text-sm font-semibold text-white">상위 유입 콘텐츠 성과 순위 (데모)</h3>
          <div class="space-y-2" id="topContentsContainer">
            <!-- JS 렌더링 -->
          </div>
        </div>
      </section>

      <!-- TAB 12: 조직·설정 (P0 실작동) -->
      <section id="tab-organization" class="tab-content hidden space-y-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-white">조직 및 지점 설정</h1>
          <p class="text-sm text-slate-400 mt-1">차마트 본사 및 지역 거점, 권한 관리, 데모 환경 관리</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 space-y-4">
            <h3 class="text-base font-semibold text-white flex items-center space-x-2">
              <i data-lucide="building" class="w-4 h-4 text-indigo-400"></i>
              <span>등록된 거점 목록 (다중 거점 아키텍처)</span>
            </h3>
            <div class="space-y-3" id="orgBranchList">
              <!-- JS 렌더링 -->
            </div>
          </div>

          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 space-y-4">
            <h3 class="text-base font-semibold text-white flex items-center space-x-2">
              <i data-lucide="shield" class="w-4 h-4 text-emerald-400"></i>
              <span>보안 및 데모 데이터 무결성</span>
            </h3>
            <div class="text-xs text-slate-300 space-y-2 bg-slate-950 p-4 rounded-lg border border-slate-800">
              <p>• <strong>데모 DB 경로:</strong> <code class="text-emerald-400">data/chamart/chamart_platform_demo.db</code></p>
              <p>• <strong>운영 데이터 격리:</strong> 정부 통계, 엔카 관측 파일럿 DB는 불변 보존</p>
              <p>• <strong>외부 접속 제어:</strong> Cloudflare Tunnel 기반 터널링 권장 (포트 직접 오픈 금지)</p>
            </div>
            <button onclick="alert('데모 데이터베이스가 안전하게 보존 중입니다.')" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium py-2 rounded-lg border border-slate-700 transition">
              데모 데이터 상태 점검
            </button>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- 모달 1: 신규 차량 등록 모달 -->
  <div id="modalVehicle" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center space-x-2">
          <i data-lucide="car" class="w-5 h-5 text-indigo-400"></i>
          <span>신규 차량 등록 (실작동)</span>
        </h3>
        <button onclick="closeModal('modalVehicle')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form onsubmit="handleCreateVehicle(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">담당 지점</label>
          <select id="vBranchId" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white"></select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">차량번호</label>
            <input type="text" id="vPlateNumber" placeholder="예: 34머 5678" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">연식 (년)</label>
            <input type="number" id="vYear" value="2022" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">모델명 (세부 트림)</label>
          <input type="text" id="vModelName" placeholder="예: 기아 쏘렌토 4세대 2.2 디젤 4WD 시그니처" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">주행거리 (km)</label>
            <input type="number" id="vMileage" value="45000" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">연료</label>
            <select id="vFuel" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
              <option value="가솔린">가솔린</option>
              <option value="디젤">디젤</option>
              <option value="하이브리드">하이브리드</option>
              <option value="전기">전기</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">매입가 (만원)</label>
            <input type="number" id="vPurchasePrice" value="2500" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">희망판매가 (만원)</label>
            <input type="number" id="vTargetPrice" value="2850" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">초기 재고 상태</label>
          <select id="vStatus" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
            <option value="PURCHASE_REVIEW">매입 검토</option>
            <option value="IN_STOCK">입고</option>
            <option value="DETAILING">상품화 진행</option>
            <option value="FOR_SALE" selected>판매 중</option>
          </select>
        </div>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalVehicle')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium">등록 완료</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 2: 고객 CRM 등록 모달 -->
  <div id="modalCustomer" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center space-x-2">
          <i data-lucide="user-plus" class="w-5 h-5 text-emerald-400"></i>
          <span>고객 CRM 신규 등록 (실작동)</span>
        </h3>
        <button onclick="closeModal('modalCustomer')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form onsubmit="handleCreateCustomer(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">담당 지점</label>
          <select id="cBranchId" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white"></select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">고객명</label>
            <input type="text" id="cName" placeholder="예: 김철수" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">연락처</label>
            <input type="text" id="cPhone" placeholder="010-0000-0000" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">관심 차종</label>
            <input type="text" id="cTargetModel" placeholder="예: 쏘렌토 / 싼타페" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">희망 예산 (만원)</label>
            <input type="number" id="cBudget" placeholder="예: 3000" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">담당 직원명</label>
          <input type="text" id="cStaff" value="장한평 김수석 매니저" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">초기 상담 메모</label>
          <textarea id="cNotes" rows="2" placeholder="유튜브 쇼츠 영상 보고 문의 접수..." class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white text-xs"></textarea>
        </div>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalCustomer')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-medium">고객 저장</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 3: 상담 기록 추가 모달 -->
  <div id="modalConsultation" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="message-circle" class="w-4 h-4 text-emerald-400"></i>
          <span>상담 이력 기록 추가</span>
        </h3>
        <button onclick="closeModal('modalConsultation')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <input type="hidden" id="consCustomerId" />
      <form onsubmit="handleCreateConsultation(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">상담 채널</label>
          <select id="consChannel" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
            <option value="전화">전화 상담</option>
            <option value="매장방문">매장 실차 방문</option>
            <option value="카카오톡">카카오톡</option>
            <option value="텔레그램">텔레그램 채널</option>
            <option value="유튜브댓글">유튜브 댓글</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">상담 내용</label>
          <textarea id="consContent" rows="3" required placeholder="고객 요청사항, 시운전 결과, 가격 조율 등..." class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white text-xs"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">담당자</label>
            <input type="text" id="consStaff" value="담당 매니저" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">후속 일정</label>
            <input type="date" id="consNextDate" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalConsultation')" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-medium">상담 저장</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 4: AI 서류 업로드 모달 -->
  <div id="modalUploadDoc" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="file-up" class="w-5 h-5 text-amber-400"></i>
          <span>계약서 / 점검기록부 업로드 (실작동)</span>
        </h3>
        <button onclick="closeModal('modalUploadDoc')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form onsubmit="handleUploadDoc(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">서류 유형</label>
          <select id="docTypeSelect" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
            <option value="TRANSFER_CERTIFICATE">자동차양도증명서</option>
            <option value="SALE_CONTRACT">자동차 매매계약서</option>
            <option value="INSPECTION_RECORD">자동차 성능·상태점검기록부</option>
            <option value="SETTLEMENT_SHEET">차량 매입·판매 정산서</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">파일 선택 (사진 / PDF, 최대 10MB)</label>
          <input type="file" id="docFileInput" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-slate-300 text-xs" />
        </div>
        <p class="text-[11px] text-slate-500">
          * 업로드 즉시 SHA-256 해시가 계산되며 대기열에 등록됩니다. 담당자 승인 전에는 거래로 확정되지 않습니다.
        </p>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalUploadDoc')" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg font-medium">업로드 분석</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 5: 영상 프로젝트 생성 모달 -->
  <div id="modalMediaProject" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="video" class="w-5 h-5 text-rose-400"></i>
          <span>AI 영상 프로젝트 생성 (실작동)</span>
        </h3>
        <button onclick="closeModal('modalMediaProject')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form onsubmit="handleCreateMediaProject(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">홍보 대상 차량 선택</label>
          <select id="mVehicleId" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
            <!-- JS 렌더링 -->
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">프로젝트 제목</label>
          <input type="text" id="mTitle" placeholder="예: [쇼츠] 장한평 무사고 쏘렌토 실매물 검증" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">포맷</label>
            <select id="mFormat" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
              <option value="SHORTS">유튜브 쇼츠 (9:16)</option>
              <option value="REELS">인스타 릴스 (9:16)</option>
              <option value="LONGFORM">유튜브 롱폼 (16:9)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">타깃 플랫폼</label>
            <select id="mPlatform" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
              <option value="YOUTUBE">유튜브</option>
              <option value="INSTAGRAM">인스타그램</option>
              <option value="TIKTOK">틱톡</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">콘셉트</label>
          <input type="text" id="mConcept" value="가성비 패밀리 SUV" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalMediaProject')" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-lg font-medium">프로젝트 생성</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 6: 거래 기록 추가 모달 -->
  <div id="modalTransaction" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="receipt" class="w-5 h-5 text-indigo-400"></i>
          <span>거래·계약 기록 등록 (실작동)</span>
        </h3>
        <button onclick="closeModal('modalTransaction')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form onsubmit="handleCreateTransaction(event)" class="space-y-3 text-sm">
        <div>
          <label class="block text-xs text-slate-400 mb-1">거래 차량 선택</label>
          <select id="tVehicleId" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white"></select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">거래 구분</label>
            <select id="tType" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white">
              <option value="SALE">판매 (고객 인도)</option>
              <option value="PURCHASE">매입 (상사 입고)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">금액 (만원)</label>
            <input type="number" id="tAmount" value="2800" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
          </div>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">거래 상대방명</label>
          <input type="text" id="tPartyName" placeholder="예: 박고객" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">거래일자</label>
          <input type="date" id="tDate" required class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white" />
        </div>
        <div class="pt-3 flex justify-end space-x-2">
          <button type="button" onclick="closeModal('modalTransaction')" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-lg">취소</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium">거래 등록</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 모달 7: 차량 타임라인 상세 모달 -->
  <div id="modalTimeline" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h3 class="text-base font-bold text-white flex items-center space-x-2">
            <i data-lucide="history" class="w-4 h-4 text-indigo-400"></i>
            <span id="timelineTitle">차량 이력 타임라인</span>
          </h3>
          <p class="text-xs text-slate-400" id="timelineSubtitle">차량번호: -</p>
        </div>
        <button onclick="closeModal('modalTimeline')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div class="space-y-3 max-h-72 overflow-y-auto pr-2 scrollbar-thin" id="timelineList">
        <!-- JS 렌더링 -->
      </div>
      <div class="pt-3 border-t border-slate-800 flex justify-end">
        <button onclick="closeModal('modalTimeline')" class="px-4 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-medium rounded-lg text-slate-200">닫기</button>
      </div>
    </div>
  </div>

  <!-- 모달 8: 외부 접속 보안 가이드 모달 -->
  <div id="modalTunnel" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center space-x-2">
          <i data-lucide="shield-check" class="w-5 h-5 text-indigo-400"></i>
          <span>외부 노트북/스마트폰 시연 보안 접속 안내</span>
        </h3>
        <button onclick="closeModal('modalTunnel')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div class="space-y-3 text-xs text-slate-300">
        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1.5 font-mono">
          <div class="text-indigo-400 font-bold">1. 현재 로컬 실행 주소:</div>
          <div class="text-white">http://localhost:8501</div>
          <div class="text-slate-400">개발 컴퓨터 내부에서 모든 기능이 정상 실행 중입니다.</div>
        </div>
        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-1.5 font-mono">
          <div class="text-emerald-400 font-bold">2. 외부 보안 터널 (Cloudflare Zero Trust 권장):</div>
          <div class="text-slate-300">포트를 외부에 직접 열지 않고, 암호화된 Cloudflare Tunnel을 통해 외부 스마트폰이나 노트북에서 접속할 수 있습니다:</div>
          <div class="bg-slate-900 p-2 rounded text-indigo-300">$ cloudflared tunnel --url http://localhost:8501</div>
          <div class="text-[11px] text-amber-300 mt-1">※ 주의: Quick Tunnel 임시 주소는 링크를 아는 누구나 접근 가능하므로, 정식 미팅 시 Cloudflare Access(이메일 OTP 인증) 정책을 반드시 적용하십시오.</div>
        </div>
        <div class="bg-amber-500/10 border border-amber-500/20 p-3 rounded-xl text-amber-300 text-[11px] space-y-1">
          <div class="font-bold">• 검증 원칙 (EXTERNAL_ACCESS_PENDING):</div>
          <div>외부 네트워크에서 실제 접속이 검증되기 전까지는 EXTERNAL_ACCESS_VERIFIED를 선언하지 않으며, 현재는 LOCAL_READY 상태로 유지됩니다. 실제 고객 개인정보는 일체 노출되지 않도록 DEMO_DATA 격리 원칙을 준수합니다.</div>
        </div>
      </div>
      <div class="pt-3 flex justify-end">
        <button onclick="closeModal('modalTunnel')" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium">확인 완료</button>
      </div>
    </div>
  </div>

  <!-- 자바스크립트 프론트엔드 비즈니스 로직 -->
  <script>
    // 전역 상태
    let currentTab = 'dashboard';
    let branches = [];
    let vehicles = [];
    let customers = [];
    let transactions = [];
    let documents = [];
    let mediaProjects = [];

    // DOM 초기화
    document.addEventListener("DOMContentLoaded", async () => {
      lucide.createIcons();
      updateClock();
      setInterval(updateClock, 1000);
      document.getElementById('tDate').value = new Date().toISOString().split('T')[0];
      
      // 세션 상태 확인
      await checkAuthStatus();
      refreshAll();
    });

    async function checkAuthStatus() {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();
        const label = document.getElementById('userNameLabel');
        const btn = document.getElementById('authBtn');
        if (data.authenticated && data.username) {
          label.innerText = '차마트 총괄관리자';
          btn.innerText = '로그아웃';
        } else {
          label.innerText = '인증 필요 (게스트)';
          btn.innerText = '로그인';
        }
      } catch (err) {
        console.error("세션 확인 실패:", err);
      }
    }

    function updateClock() {
      const now = new Date();
      const str = now.toISOString().slice(0, 16).replace('T', ' ');
      const clockEl = document.getElementById('currentClock');
      if (clockEl) clockEl.innerText = str;
    }

    // 탭 전환
    function switchTab(tabName) {
      currentTab = tabName;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-item').forEach(el => {
        el.classList.remove('bg-indigo-600', 'text-white');
        el.classList.add('text-slate-300', 'hover:bg-slate-800/60');
      });

      const targetTab = document.getElementById(`tab-${tabName}`);
      if (targetTab) targetTab.classList.remove('hidden');

      const activeNav = document.getElementById(`nav-${tabName}`);
      if (activeNav) {
        activeNav.classList.remove('text-slate-300', 'text-slate-400', 'hover:bg-slate-800/60');
        activeNav.classList.add('bg-indigo-600', 'text-white');
      }
      lucide.createIcons();
    }

    // 모달 제어
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); lucide.createIcons(); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
    function openTunnelModal() { openModal('modalTunnel'); }
    function openNewVehicleModal() { openModal('modalVehicle'); }
    function openNewCustomerModal() { openModal('modalCustomer'); }
    function openUploadDocModal() { openModal('modalUploadDoc'); }
    function openNewMediaModal() { openModal('modalMediaProject'); }
    function openNewTransactionModal() { openModal('modalTransaction'); }

    // 데이터 전체 갱신
    async function refreshAll() {
      await loadBranches();
      await loadOverview();
      await loadVehicles();
      await loadCustomers();
      await loadTransactions();
      await loadDocuments();
      await loadMediaProjects();
      await loadMarketingFunnel();
    }

    // 1. 거점 목록
    async function loadBranches() {
      try {
        const res = await fetch('/api/branches');
        branches = await res.json();
        
        // 지점 드롭다운 채우기
        const vBranchSelect = document.getElementById('vBranchId');
        const cBranchSelect = document.getElementById('cBranchId');
        const vBranchFilter = document.getElementById('vehicleBranchFilter');
        
        vBranchSelect.innerHTML = '';
        cBranchSelect.innerHTML = '';
        vBranchFilter.innerHTML = '<option value="">전체 지점</option>';

        branches.forEach(b => {
          const opt = `<option value="${b.id}">${b.name}</option>`;
          vBranchSelect.innerHTML += opt;
          cBranchSelect.innerHTML += opt;
          vBranchFilter.innerHTML += `<option value="${b.id}">${b.name}</option>`;
        });

        // 조직 탭 지점 리스트 렌더링
        const orgBranchList = document.getElementById('orgBranchList');
        if (orgBranchList) {
          orgBranchList.innerHTML = branches.map(b => `
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex items-center justify-between">
              <div>
                <div class="text-sm font-semibold text-white flex items-center space-x-1.5">
                  <span>${b.name}</span>
                  ${b.is_headquarters ? '<span class="text-[10px] bg-indigo-500/20 text-indigo-300 px-1.5 py-0.2 rounded font-mono">본사</span>' : ''}
                </div>
                <div class="text-xs text-slate-400 mt-0.5">${b.address || b.region}</div>
              </div>
              <span class="text-xs text-emerald-400 font-mono">운영 중</span>
            </div>
          `).join('');
        }
      } catch (err) {
        console.error("거점 목록 로드 실패:", err);
      }
    }

    // 2. 대시보드 KPI
    async function loadOverview() {
      try {
        const res = await fetch('/api/overview');
        const data = await res.json();
        const kpi = data.kpis;

        document.getElementById('kpiTotalVehicles').innerText = kpi.total_vehicles;
        document.getElementById('kpiForSaleVehicles').innerText = `${kpi.for_sale_vehicles}대 판매 중`;
        document.getElementById('kpiTotalCustomers').innerText = kpi.total_customers;
        document.getElementById('kpiActiveConsultations').innerText = `${kpi.active_consultations}명 상담 진행`;
        document.getElementById('kpiTotalProjects').innerText = kpi.total_projects;
        document.getElementById('kpiInProdProjects').innerText = `${kpi.in_prod_projects}건 제작/검토 중`;
        document.getElementById('kpiPendingDocs').innerText = kpi.pending_docs;
        document.getElementById('kpiPurchaseSum').innerText = `${kpi.purchase_sum_million_krw.toLocaleString()}만원`;
        document.getElementById('kpiSaleSum').innerText = `${kpi.sale_sum_million_krw.toLocaleString()}만원`;

        // 사이드바 배지
        document.getElementById('sidebarVehicleBadge').innerText = kpi.total_vehicles;
        document.getElementById('sidebarCrmBadge').innerText = kpi.total_customers;
        document.getElementById('sidebarStudioBadge').innerText = kpi.total_projects;
        document.getElementById('sidebarDocBadge').innerText = `대기 ${kpi.pending_docs}`;

        // 거점 요약 렌더링
        const container = document.getElementById('branchesSummaryContainer');
        container.innerHTML = data.branches.map(b => `
          <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex items-center justify-between">
            <div>
              <div class="text-sm font-semibold text-white">${b.name}</div>
              <div class="text-xs text-slate-500">${b.region}</div>
            </div>
            <div class="text-right text-xs">
              <span class="text-indigo-400 font-bold">${b.vehicle_count}대</span> 차량 /
              <span class="text-emerald-400 font-bold">${b.customer_count}명</span> 고객
            </div>
          </div>
        `).join('');

      } catch (err) {
        console.error("KPI 로드 실패:", err);
      }
    }

    // 3. 차량 관리 (CRUD)
    async function loadVehicles() {
      try {
        const bId = document.getElementById('vehicleBranchFilter').value;
        const status = document.getElementById('vehicleStatusFilter').value;
        let url = '/api/vehicles?';
        if (bId) url += `branch_id=${bId}&`;
        if (status) url += `status=${status}&`;

        const res = await fetch(url);
        vehicles = await res.json();

        document.getElementById('vehicleCountText').innerText = `총 ${vehicles.length}대 등록됨`;

        // 모달 내 차량 셀렉트 옵션도 동기화
        const mVehicleSelect = document.getElementById('mVehicleId');
        const tVehicleSelect = document.getElementById('tVehicleId');
        if (mVehicleSelect) {
          mVehicleSelect.innerHTML = vehicles.map(v => `<option value="${v.id}">[${v.plate_number}] ${v.model_name}</option>`).join('');
        }
        if (tVehicleSelect) {
          tVehicleSelect.innerHTML = vehicles.map(v => `<option value="${v.id}">[${v.plate_number}] ${v.model_name}</option>`).join('');
        }

        const tbody = document.getElementById('vehicleTableBody');
        tbody.innerHTML = vehicles.map(v => {
          let statusBadge = '';
          switch (v.status) {
            case 'FOR_SALE': statusBadge = '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded text-xs">판매 중</span>'; break;
            case 'DETAILING': statusBadge = '<span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded text-xs">상품화 진행</span>'; break;
            case 'CONTRACTING': statusBadge = '<span class="bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2 py-0.5 rounded text-xs">계약 진행</span>'; break;
            case 'SOLD': statusBadge = '<span class="bg-slate-700 text-slate-300 px-2 py-0.5 rounded text-xs">판매 완료</span>'; break;
            default: statusBadge = `<span class="bg-slate-800 text-slate-400 px-2 py-0.5 rounded text-xs">${v.status}</span>`;
          }

          return `
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-4 py-3 font-semibold text-white">${v.plate_number}</td>
              <td class="px-4 py-3 text-slate-200">
                <div class="font-medium">${v.model_name}</div>
                <div class="text-xs text-slate-500">${v.fuel_type} · ${v.color}</div>
              </td>
              <td class="px-4 py-3 text-slate-300 font-mono text-xs">${v.year}년 · ${v.mileage.toLocaleString()}km</td>
              <td class="px-4 py-3 text-xs">
                <div class="text-slate-400">매입: ${v.purchase_price.toLocaleString()}만원</div>
                <div class="text-indigo-400 font-bold">희망: ${v.target_price.toLocaleString()}만원</div>
              </td>
              <td class="px-4 py-3 text-xs text-slate-400">${v.branch_name}</td>
              <td class="px-4 py-3">${statusBadge}</td>
              <td class="px-4 py-3 text-right space-x-1">
                <button onclick="changeVehicleStatusPrompt('${v.id}')" class="text-xs bg-slate-800 hover:bg-slate-700 text-indigo-300 px-2 py-1 rounded transition border border-slate-700">상태변경</button>
                <button onclick="viewVehicleTimeline('${v.id}')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-1 rounded transition border border-slate-700">이력</button>
              </td>
            </tr>
          `;
        }).join('');
      } catch (err) {
        console.error("차량 로드 실패:", err);
      }
    }

    async function handleCreateVehicle(e) {
      e.preventDefault();
      const body = {
        branch_id: document.getElementById('vBranchId').value,
        plate_number: document.getElementById('vPlateNumber').value,
        model_name: document.getElementById('vModelName').value,
        year: parseInt(document.getElementById('vYear').value),
        mileage: parseInt(document.getElementById('vMileage').value),
        fuel_type: document.getElementById('vFuel').value,
        purchase_price: parseInt(document.getElementById('vPurchasePrice').value || 0),
        target_price: parseInt(document.getElementById('vTargetPrice').value || 0),
        status: document.getElementById('vStatus').value,
      };

      try {
        const res = await fetch('/api/vehicles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          closeModal('modalVehicle');
          await refreshAll();
          alert('차량이 정상 등록되었습니다.');
        } else {
          alert('차량 등록 실패');
        }
      } catch (err) {
        alert('서버 통신 오류');
      }
    }

    async function changeVehicleStatusPrompt(vehicleId) {
      const nextStatus = prompt("변경할 재고 상태를 입력하세요:\n(PURCHASE_REVIEW, IN_STOCK, DETAILING, FOR_SALE, CONTRACTING, SOLD)", "FOR_SALE");
      if (!nextStatus) return;

      const reason = prompt("상태 변경 사유를 입력하세요 (선택):", "관리자 확인");

      try {
        const res = await fetch(`/api/vehicles/${vehicleId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: nextStatus, reason: reason }),
        });
        if (res.ok) {
          await refreshAll();
          alert('상태가 정상 변경되었습니다.');
        } else {
          alert('상태 변경 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    async function viewVehicleTimeline(vehicleId) {
      try {
        const res = await fetch(`/api/vehicles/${vehicleId}`);
        const data = await res.json();
        document.getElementById('timelineTitle').innerText = `${data.model_name}`;
        document.getElementById('timelineSubtitle').innerText = `차량번호: ${data.plate_number} (${data.branch_name})`;

        const container = document.getElementById('timelineList');
        if (!data.timeline || data.timeline.length === 0) {
          container.innerHTML = '<p class="text-xs text-slate-500">등록된 이력이 없습니다.</p>';
        } else {
          container.innerHTML = data.timeline.map(t => `
            <div class="bg-slate-950 p-2.5 rounded-lg border border-slate-800 text-xs">
              <div class="text-slate-500 font-mono text-[11px]">${t.timestamp}</div>
              <div class="text-slate-200 mt-0.5">${t.event}</div>
            </div>
          `).join('');
        }
        openModal('modalTimeline');
      } catch (err) {
        alert('이력 조회 실패');
      }
    }

    // 4. 고객 CRM (CRUD)
    async function loadCustomers() {
      try {
        const q = document.getElementById('crmSearchInput').value;
        let url = '/api/customers?';
        if (q) url += `query=${encodeURIComponent(q)}&`;

        const res = await fetch(url);
        customers = await res.json();

        document.getElementById('customerCountText').innerText = `총 ${customers.length}명 관리 중`;

        const tbody = document.getElementById('customerTableBody');
        tbody.innerHTML = customers.map(c => `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3 font-semibold text-white">${c.name}</td>
            <td class="px-4 py-3 font-mono text-xs text-slate-300">${c.phone}</td>
            <td class="px-4 py-3 text-slate-300">${c.target_vehicle_model}</td>
            <td class="px-4 py-3 text-indigo-400 font-bold text-xs">${c.budget_max ? c.budget_max.toLocaleString() + '만원' : '-'}</td>
            <td class="px-4 py-3 text-xs text-slate-400">${c.assigned_staff}</td>
            <td class="px-4 py-3">
              <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded text-xs">${c.status}</span>
            </td>
            <td class="px-4 py-3 text-right">
              <button onclick="openConsultationModal('${c.id}')" class="text-xs bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-700/50 px-2.5 py-1 rounded transition">상담 추가 (${c.consultation_count}건)</button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        console.error("고객 로드 실패:", err);
      }
    }

    async function handleCreateCustomer(e) {
      e.preventDefault();
      const body = {
        branch_id: document.getElementById('cBranchId').value,
        name: document.getElementById('cName').value,
        phone: document.getElementById('cPhone').value,
        target_vehicle_model: document.getElementById('cTargetModel').value,
        budget_max: parseInt(document.getElementById('cBudget').value || 0),
        assigned_staff: document.getElementById('cStaff').value,
        notes: document.getElementById('cNotes').value,
      };

      try {
        const res = await fetch('/api/customers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          closeModal('modalCustomer');
          await refreshAll();
          alert('고객이 등록되었습니다.');
        } else {
          alert('고객 등록 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    function openConsultationModal(customerId) {
      document.getElementById('consCustomerId').value = customerId;
      openModal('modalConsultation');
    }

    async function handleCreateConsultation(e) {
      e.preventDefault();
      const customerId = document.getElementById('consCustomerId').value;
      const body = {
        channel: document.getElementById('consChannel').value,
        content: document.getElementById('consContent').value,
        staff_name: document.getElementById('consStaff').value,
        next_action_date: document.getElementById('consNextDate').value || null,
      };

      try {
        const res = await fetch(`/api/customers/${customerId}/consultations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          closeModal('modalConsultation');
          await refreshAll();
          alert('상담 이력이 등록되었습니다.');
        } else {
          alert('상담 등록 실패');
        }
      } catch (err) {
        alert('통신 오류');
      }
    }

    // 5. 거래·계약 관리
    async function loadTransactions() {
      try {
        const res = await fetch('/api/transactions');
        transactions = await res.json();

        const tbody = document.getElementById('transactionTableBody');
        tbody.innerHTML = transactions.map(t => `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3 font-mono text-xs text-slate-300">${t.transaction_date}</td>
            <td class="px-4 py-3">
              <span class="${t.transaction_type === 'PURCHASE' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20'} px-2 py-0.5 rounded text-xs font-semibold">
                ${t.transaction_type === 'PURCHASE' ? '매입' : '판매'}
              </span>
            </td>
            <td class="px-4 py-3 text-slate-200">
              <span class="font-bold text-white">[${t.vehicle_plate}]</span> ${t.vehicle_model}
            </td>
            <td class="px-4 py-3 font-bold text-white">${t.amount.toLocaleString()}만원</td>
            <td class="px-4 py-3 text-xs text-slate-300">${t.party_name}</td>
            <td class="px-4 py-3">
              <span class="text-xs text-emerald-400 font-mono">${t.settlement_status}</span>
            </td>
            <td class="px-4 py-3 text-xs text-slate-400">${t.notes}</td>
          </tr>
        `).join('');
      } catch (err) {
        console.error("거래 로드 실패:", err);
      }
    }

    async function handleCreateTransaction(e) {
      e.preventDefault();
      const body = {
        vehicle_id: document.getElementById('tVehicleId').value,
        transaction_type: document.getElementById('tType').value,
        amount: parseInt(document.getElementById('tAmount').value),
        party_name: document.getElementById('tPartyName').value,
        transaction_date: document.getElementById('tDate').value,
        notes: "플랫폼 화면에서 직접 등록된 거래",
      };

      try {
        const res = await fetch('/api/transactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          closeModal('modalTransaction');
          await refreshAll();
          alert('거래 기록이 성공적으로 등록되었습니다.');
        } else {
          alert('거래 등록 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    // 6. AI 서류 인식
    async function loadDocuments() {
      try {
        const res = await fetch('/api/documents');
        documents = await res.json();

        const tbody = document.getElementById('documentTableBody');
        tbody.innerHTML = documents.map(d => {
          let statusBadge = '';
          if (d.review_status === 'APPROVED') {
            statusBadge = '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded text-xs font-semibold">승인 완료</span>';
          } else {
            statusBadge = '<span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded text-xs font-semibold">검토 대기</span>';
          }

          const extracted = d.extracted_data.extracted_fields || {};
          const metaSummary = Object.entries(extracted).map(([k, v]) => `${k}: ${v}`).join(' | ');

          return `
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-4 py-3 font-mono text-xs text-slate-400">${d.created_at}</td>
              <td class="px-4 py-3 text-xs font-medium text-slate-200">${d.doc_type}</td>
              <td class="px-4 py-3 text-xs">
                <div class="font-semibold text-white">${d.filename}</div>
                <div class="font-mono text-[10px] text-slate-500">${d.file_sha256.slice(0, 16)}... (${d.file_size_kb} KB)</div>
              </td>
              <td class="px-4 py-3 text-xs text-slate-300 max-w-xs truncate">${metaSummary || '-'}</td>
              <td class="px-4 py-3">${statusBadge}</td>
              <td class="px-4 py-3 text-right">
                ${d.review_status === 'PENDING' ? `
                  <button onclick="approveDoc('${d.id}')" class="text-xs bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-1 rounded transition">승인 확정</button>
                ` : `
                  <span class="text-xs text-slate-500 font-mono">승인자: ${d.approved_by}</span>
                `}
              </td>
            </tr>
          `;
        }).join('');
      } catch (err) {
        console.error("서류 로드 실패:", err);
      }
    }

    async function handleUploadDoc(e) {
      e.preventDefault();
      const fileInput = document.getElementById('docFileInput');
      if (!fileInput.files.length) return;

      const formData = new FormData();
      formData.append('file', fileInput.files[0]);
      formData.append('doc_type', document.getElementById('docTypeSelect').value);

      try {
        const res = await fetch('/api/documents/upload', {
          method: 'POST',
          body: formData,
        });
        const result = await res.json();
        if (res.ok) {
          closeModal('modalUploadDoc');
          await refreshAll();
          alert(`서류가 성공적으로 업로드되었습니다.\n(SHA-256: ${result.sha256.slice(0, 16)}...)`);
        } else {
          alert(`업로드 실패: ${result.detail || '오류'}`);
        }
      } catch (err) {
        alert('서버 업로드 오류');
      }
    }

    async function approveDoc(docId) {
      if (!confirm('해당 서류의 AI 추출 정보를 검토 후 최종 승인하시겠습니까?')) return;
      try {
        const res = await fetch(`/api/documents/${docId}/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approved: true, reviewer_name: '차마트 총괄관리자' }),
        });
        if (res.ok) {
          await refreshAll();
          alert('서류 검토 승인이 완료되었습니다.');
        } else {
          alert('승인 처리 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    // 7. AI 영상 스튜디오
    async function loadMediaProjects() {
      try {
        const res = await fetch('/api/media-projects');
        mediaProjects = await res.json();

        const tbody = document.getElementById('mediaProjectTableBody');
        tbody.innerHTML = mediaProjects.map(p => {
          let statusBadge = '';
          switch (p.status) {
            case 'APPROVED': statusBadge = '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded text-xs">승인 완료</span>'; break;
            case 'IN_PRODUCTION': statusBadge = '<span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 px-2 py-0.5 rounded text-xs">제작 진행 중</span>'; break;
            case 'REVIEW': statusBadge = '<span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded text-xs">검수 단계</span>'; break;
            default: statusBadge = `<span class="bg-slate-800 text-slate-300 px-2 py-0.5 rounded text-xs">${p.status}</span>`;
          }

          return `
            <tr class="hover:bg-slate-800/40 transition">
              <td class="px-4 py-3 font-semibold text-white">${p.title}</td>
              <td class="px-4 py-3 text-xs text-slate-200">
                <span class="font-bold text-indigo-300">[${p.vehicle_plate}]</span> ${p.vehicle_model}
              </td>
              <td class="px-4 py-3 text-xs">
                <span class="bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded">${p.content_format}</span>
                <span class="text-slate-400 ml-1">${p.concept}</span>
              </td>
              <td class="px-4 py-3 text-xs text-slate-400 max-w-xs truncate">${p.script_draft || '-'}</td>
              <td class="px-4 py-3">${statusBadge}</td>
              <td class="px-4 py-3 text-right">
                <button onclick="advanceMediaWorkflow('${p.id}', '${p.status}')" class="text-xs bg-slate-800 hover:bg-slate-700 text-rose-300 border border-slate-700 px-2.5 py-1 rounded transition">상태 전이</button>
              </td>
            </tr>
          `;
        }).join('');
      } catch (err) {
        console.error("영상 프로젝트 로드 실패:", err);
      }
    }

    async function handleCreateMediaProject(e) {
      e.preventDefault();
      const body = {
        title: document.getElementById('mTitle').value,
        vehicle_id: document.getElementById('mVehicleId').value,
        content_format: document.getElementById('mFormat').value,
        target_platform: document.getElementById('mPlatform').value,
        concept: document.getElementById('mConcept').value,
      };

      try {
        const res = await fetch('/api/media-projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          closeModal('modalMediaProject');
          await refreshAll();
          alert('영상 프로젝트가 생성되었습니다.');
        } else {
          alert('프로젝트 생성 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    async function advanceMediaWorkflow(projectId, currentStatus) {
      const order = ['DRAFT', 'REQUESTED', 'IN_PRODUCTION', 'REVIEW', 'APPROVED', 'DELIVERED'];
      const nextIdx = (order.indexOf(currentStatus) + 1) % order.length;
      const nextStatus = order[nextIdx];

      if (!confirm(`워크플로우 상태를 '${currentStatus}' 에서 '${nextStatus}' 로 변경하시겠습니까?`)) return;

      try {
        const res = await fetch(`/api/media-projects/${projectId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: nextStatus }),
        });
        if (res.ok) {
          await refreshAll();
        } else {
          alert('상태 변경 실패');
        }
      } catch (err) {
        alert('오류 발생');
      }
    }

    // 8. 마케팅 퍼널 데이터 렌더링
    async function loadMarketingFunnel() {
      try {
        const res = await fetch('/api/marketing/performance');
        const data = await res.json();

        const container = document.getElementById('marketingFunnelContainer');
        if (container) {
          container.innerHTML = data.funnel.map(f => `
            <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 text-center">
              <div class="text-xs text-slate-400 font-medium">${f.stage}</div>
              <div class="text-2xl font-bold text-white mt-1 font-mono">${f.count.toLocaleString()}</div>
              <div class="text-[11px] text-slate-500 mt-1">${f.note}</div>
            </div>
          `).join('');
        }

        const topContainer = document.getElementById('topContentsContainer');
        if (topContainer) {
          topContainer.innerHTML = data.top_contents.map(c => `
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-200 font-medium">${c.title}</span>
              <div class="space-x-3 text-slate-400 font-mono">
                <span>조회: <strong class="text-white">${c.views.toLocaleString()}</strong></span>
                <span>문의: <strong class="text-indigo-400">${c.inquiries}건</strong></span>
              </div>
            </div>
          `).join('');
        }
      } catch (err) {
        console.error("마케팅 퍼널 로드 실패:", err);
      }
    }

    // 인증 핸들러
    async function handleAuthAction() {
      const btn = document.getElementById('authBtn');
      if (btn.innerText === '로그아웃') {
        await fetch('/api/auth/logout', { method: 'POST' });
        document.getElementById('userNameLabel').innerText = '인증 필요 (게스트)';
        btn.innerText = '로그인';
        alert('로그아웃되었습니다.');
        refreshAll();
      } else {
        const pw = prompt('관리자 비밀번호를 입력하세요:');
        if (pw) {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: 'admin', password: pw }),
          });
          if (res.ok) {
            document.getElementById('userNameLabel').innerText = '차마트 총괄관리자';
            btn.innerText = '로그아웃';
            alert('로그인되었습니다.');
            refreshAll();
          } else if (res.status === 429) {
            alert('로그인 시도 한도를 초과했습니다. 60초 후 다시 시도하십시오.');
          } else {
            alert('인증 실패: 비밀번호가 일치하지 않습니다.');
          }
        }
      }
    }
  </script>
</body>
</html>
