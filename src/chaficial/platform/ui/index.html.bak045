<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>차마트(CHAMART) 통합 운영 플랫폼</title>
  <!-- Tailwind CSS & Pretendard Font & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif; }
    .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- 상단 글로벌 헤더 -->
  <header class="h-16 bg-slate-900/90 backdrop-blur border-b border-slate-800 flex items-center justify-between px-6 sticky top-0 z-40">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center font-black text-xl shadow-lg shadow-indigo-500/20">
        차
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <span class="font-bold text-lg tracking-tight">CHAMART OS</span>
          <span class="text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full">DEMO ENVIRONMENT</span>
          <span class="text-[11px] font-medium bg-slate-800 text-slate-400 px-2 py-0.5 rounded">v1.0-alpha</span>
        </div>
        <p class="text-xs text-slate-400 hidden sm:block">차마트 법인 장한평 본사 & 거점 확장 통합 운영 플랫폼</p>
      </div>
    </div>

    <div class="flex items-center space-x-4">
      <!-- 외부 접속 가이드 버튼 -->
      <button onclick="openTunnelModal()" class="flex items-center space-x-1.5 text-xs bg-indigo-950/60 hover:bg-indigo-900/70 text-indigo-300 border border-indigo-700/50 px-3 py-1.5 rounded-lg transition">
        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
        <span>외부 시연 보안접속 안내</span>
      </button>

      <!-- 사용자 프로필 / 로그인 -->
      <div class="flex items-center space-x-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">
        <div class="w-6 h-6 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-xs font-bold" id="userAvatar">관</div>
        <span class="text-xs font-medium text-slate-200" id="userNameLabel">차마트 총괄관리자</span>
        <button onclick="handleAuthAction()" class="text-[11px] text-slate-400 hover:text-rose-400 ml-1 transition" id="authBtn">로그아웃</button>
      </div>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <!-- 좌측 사이드바: 12대 전체 메뉴 네비게이션 -->
    <aside class="w-64 bg-slate-900/60 border-r border-slate-800 flex flex-col justify-between overflow-y-auto scrollbar-thin">
      <div class="p-3 space-y-6">
        <!-- 핵심 운영 영역 -->
        <div>
          <div class="text-[11px] font-semibold tracking-wider text-slate-500 uppercase px-3 mb-2">실작동 코어 운영</div>
          <nav class="space-y-1">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition bg-indigo-600 text-white">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                <span>대시보드</span>
              </div>
            </button>
            <button onclick="switchTab('vehicles')" id="nav-vehicles" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="car" class="w-4 h-4"></i>
                <span>차량 관리</span>
              </div>
              <span class="text-[10px] bg-indigo-500/20 text-indigo-300 px-1.5 py-0.5 rounded font-mono" id="sidebarVehicleBadge">4</span>
            </button>
            <button onclick="switchTab('crm')" id="nav-crm" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="users" class="w-4 h-4"></i>
                <span>고객 CRM</span>
              </div>
              <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-mono" id="sidebarCrmBadge">3</span>
            </button>
            <button onclick="switchTab('transactions')" id="nav-transactions" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="receipt" class="w-4 h-4"></i>
                <span>거래·계약 관리</span>
              </div>
            </button>
            <button onclick="switchTab('documents')" id="nav-documents" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="file-scan" class="w-4 h-4"></i>
                <span>AI 서류 인식</span>
              </div>
              <span class="text-[10px] bg-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded font-mono" id="sidebarDocBadge">대기 1</span>
            </button>
            <button onclick="switchTab('studio')" id="nav-studio" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="video" class="w-4 h-4"></i>
                <span>AI 영상 스튜디오</span>
              </div>
              <span class="text-[10px] bg-rose-500/20 text-rose-300 px-1.5 py-0.5 rounded font-mono" id="sidebarStudioBadge">2</span>
            </button>
          </nav>
        </div>

        <!-- 분석 및 기존 자산 연결 -->
        <div>
          <div class="text-[11px] font-semibold tracking-wider text-slate-500 uppercase px-3 mb-2">분석 및 마켓 인텔리전스</div>
          <nav class="space-y-1">
            <button onclick="switchTab('market-analysis')" id="nav-market-analysis" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="line-chart" class="w-4 h-4"></i>
                <span>AI 매물 분석</span>
              </div>
              <span class="text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">엔카 관측</span>
            </button>
            <button onclick="switchTab('marketing')" id="nav-marketing" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
                <span>마케팅 성과</span>
              </div>
              <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-1.5 py-0.5 rounded border border-indigo-500/20">퍼널 구조</span>
            </button>
          </nav>
        </div>

        <!-- 커뮤니티 및 미래 연동 (P1) -->
        <div>
          <div class="text-[11px] font-semibold tracking-wider text-slate-500 uppercase px-3 mb-2">외부 연동 및 채널 (Phase 2)</div>
          <nav class="space-y-1">
            <button onclick="switchTab('telegram')" id="nav-telegram" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-400 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>텔레그램 센터</span>
              </div>
              <span class="text-[10px] bg-amber-500/10 text-amber-400 px-1.5 py-0.5 rounded border border-amber-500/20">연동대기</span>
            </button>
            <button onclick="switchTab('sms')" id="nav-sms" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-400 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="message-square" class="w-4 h-4"></i>
                <span>문자 메시지 센터</span>
              </div>
              <span class="text-[10px] bg-amber-500/10 text-amber-400 px-1.5 py-0.5 rounded border border-amber-500/20">게이트웨이</span>
            </button>
            <button onclick="switchTab('carmanager')" id="nav-carmanager" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-400 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                <span>카매니저 연동</span>
              </div>
              <span class="text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">규격검토</span>
            </button>
            <button onclick="switchTab('organization')" id="nav-organization" class="nav-item w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:bg-slate-800/60">
              <div class="flex items-center space-x-2.5">
                <i data-lucide="building" class="w-4 h-4"></i>
                <span>조직·지점 설정</span>
              </div>
              <span class="text-[10px] bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded font-mono">2개 거점</span>
            </button>
          </nav>
        </div>
      </div>

      <!-- 하단 시스템 상태 -->
      <div class="p-3 border-t border-slate-800 bg-slate-900/40 text-xs space-y-2">
        <div class="flex items-center justify-between text-slate-400">
          <span>거점 모드</span>
          <span class="text-indigo-400 font-medium">장한평 본사 / 수원 (확장 예정 거점)</span>
        </div>
        <div class="flex items-center justify-between text-slate-400">
          <span>데모 DB</span>
          <span class="text-emerald-400 font-mono">격리 보존 (OK)</span>
        </div>
      </div>
    </aside>

    <!-- 메인 콘텐츠 영역 -->
    <main class="flex-1 overflow-y-auto p-6 scrollbar-thin bg-slate-950">
      
      <!-- TAB 1: 대시보드 -->
      <section id="tab-dashboard" class="tab-content space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-white">차마트 통합 운영 현황 대시보드</h1>
            <p class="text-sm text-slate-400 mt-1">장한평 본사와 수원 지점의 실시간 매입, 재고, 고객 상담 및 영상 콘텐츠 파이프라인</p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-xs bg-slate-800 text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-1.5">
              <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-400"></i>
              <span id="currentClock">2026-10-26 02:50</span>
            </span>
            <button onclick="refreshAll()" class="p-1.5 text-slate-400 hover:text-white bg-slate-800 rounded-lg hover:bg-slate-700 transition">
              <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <!-- 4대 핵심 KPI 카드 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">총 보유 차량 / 판매 중</span>
              <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
                <i data-lucide="car" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-3xl font-bold text-white" id="kpiTotalVehicles">4</span>
              <span class="text-sm text-emerald-400 font-medium" id="kpiForSaleVehicles">2대 판매 중</span>
            </div>
            <p class="text-xs text-slate-500 mt-2">상품화 진행 1대 / 계약 1대</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">CRM 고객 / 활성 상담</span>
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                <i data-lucide="users" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-3xl font-bold text-white" id="kpiTotalCustomers">3</span>
              <span class="text-sm text-emerald-400 font-medium" id="kpiActiveConsultations">2명 상담 진행</span>
            </div>
            <p class="text-xs text-slate-500 mt-2">유튜브 쇼츠 & 텔레그램 유입 연결</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">AI 영상 스튜디오 프로젝트</span>
              <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center">
                <i data-lucide="video" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-3xl font-bold text-white" id="kpiTotalProjects">2</span>
              <span class="text-sm text-rose-400 font-medium" id="kpiInProdProjects">1건 제작/검토 중</span>
            </div>
            <p class="text-xs text-slate-500 mt-2">쇼츠 1건 승인 완료 / 릴스 1건 제작</p>
          </div>

          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">AI 서류 검토 대기열</span>
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center">
                <i data-lucide="file-check" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-3xl font-bold text-white" id="kpiPendingDocs">1</span>
              <span class="text-sm text-amber-400 font-medium">검토 승인 대기</span>
            </div>
            <p class="text-xs text-slate-500 mt-2">승인 전 거래 확정 방지 필터 적용</p>
          </div>
        </div>

        <!-- 거점별 현황 요약 및 최근 활동 -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- 거점별 현황 -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 lg:col-span-1 space-y-4">
            <h2 class="text-base font-semibold text-white flex items-center space-x-2">
              <i data-lucide="map-pin" class="w-4 h-4 text-indigo-400"></i>
              <span>거점별 차량 & 고객 배분</span>
            </h2>
            <div class="space-y-3" id="branchesSummaryContainer">
              <!-- JS 렌더링 -->
            </div>
            <div class="pt-3 border-t border-slate-800/80 text-xs text-slate-400">
              * 장한평 본사 체계를 수원 및 수도권 거점으로 확장 중입니다.
            </div>
          </div>

          <!-- 주요 업무 바로가기 & 빠른 작업 -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 lg:col-span-2 space-y-4">
            <h2 class="text-base font-semibold text-white flex items-center space-x-2">
              <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
              <span>차마트 4대 실제 작동 업무 퀵액션</span>
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button onclick="openNewVehicleModal()" class="flex flex-col items-center justify-center p-4 bg-slate-800/50 hover:bg-slate-800 rounded-xl border border-slate-700/60 transition group">
                <div class="w-10 h-10 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center group-hover:scale-110 transition">
                  <i data-lucide="plus-circle" class="w-5 h-5"></i>
                </div>
                <span class="text-xs font-medium text-slate-200 mt-2">신규 차량 등록</span>
              </button>
              <button onclick="openNewCustomerModal()" class="flex flex-col items-center justify-center p-4 bg-slate-800/50 hover:bg-slate-800 rounded-xl border border-slate-700/60 transition group">
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition">
                  <i data-lucide="user-plus" class="w-5 h-5"></i>
                </div>
                <span class="text-xs font-medium text-slate-200 mt-2">고객 CRM 등록</span>
              </button>
              <button onclick="openUploadDocModal()" class="flex flex-col items-center justify-center p-4 bg-slate-800/50 hover:bg-slate-800 rounded-xl border border-slate-700/60 transition group">
                <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center group-hover:scale-110 transition">
                  <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                </div>
                <span class="text-xs font-medium text-slate-200 mt-2">계약서 사진 업로드</span>
              </button>
              <button onclick="openNewMediaModal()" class="flex flex-col items-center justify-center p-4 bg-slate-800/50 hover:bg-slate-800 rounded-xl border border-slate-700/60 transition group">
                <div class="w-10 h-10 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center group-hover:scale-110 transition">
                  <i data-lucide="video" class="w-5 h-5"></i>
                </div>
                <span class="text-xs font-medium text-slate-200 mt-2">영상 프로젝트 생성</span>
              </button>
            </div>

            <!-- 최근 거래 현황 박스 -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3.5">
              <div class="flex items-center justify-between text-xs font-medium mb-2">
                <span class="text-slate-400">데모 누적 거래 실적</span>
                <span class="text-indigo-400">정산 확정</span>
              </div>
              <div class="grid grid-cols-2 gap-4 text-sm font-semibold">
                <div>매입 정산: <span class="text-emerald-400" id="kpiPurchaseSum">2,450만원</span></div>
                <div>판매 정산: <span class="text-indigo-400" id="kpiSaleSum">4,550만원</span> (계약 진행 1건)</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 2: 차량 관리 (P0 실작동) -->
      <section id="tab-vehicles" class="tab-content hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-white">차량 관리</h1>
            <p class="text-sm text-slate-400 mt-1">차마트 보유 차량의 매입, 상품화, 전시 판매, 계약 및 타임라인 이력 관리</p>
          </div>
          <button onclick="openNewVehicleModal()" class="flex items-center space-x-2 bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition shadow-lg shadow-indigo-600/20">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>차량 신규 등록</span>
          </button>
        </div>

        <!-- 필터바 -->
